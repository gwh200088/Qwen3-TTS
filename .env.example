# ============================================================================
# Qwen3-TTS 服务环境变量样例
# 用法：cp .env.example .env  然后按需修改（docker compose 自动读取）
# ============================================================================

# 对外暴露端口（宿主）
SERVICE_PORT=8000

# 模型权重目录（宿主路径，compose 将以 :ro 挂载到容器 /models）
# 目录需包含 Qwen3-TTS-12Hz-1.7B-Base/（内含 speech_tokenizer 子目录）
MODEL_DIR=./models

# 容器内模型子目录名（一般无需修改；换 0.6B 等模型时改这里）
MODEL_PATH=/models/Qwen3-TTS-12Hz-1.7B-Base

# 音色库数据目录（宿主路径，挂载到容器 /data；重启容器音色仍在，请指向持久盘）
DATA_DIR=./data

# ---------------- GPU 兼容策略（T4 / A10） ----------------
# 设备；无 GPU 调试可改 cpu:0（极慢）
DEVICE=cuda:0

# 模型精度：auto | fp16 | bf16 | fp32
#   T4(Turing) 不支持 bf16 → 即使选 bf16 也会自动回退 fp16
#   A10(Ampere) 建议 fp16（默认）；追求更佳精度可手动 bf16
MODEL_DTYPE=auto

# 注意力实现：auto | eager | sdpa | flash_attention_2
#   auto：已安装 flash-attn 且 A10(Ampere+) 时启用 FA2；否则一律 eager（最稳）
#   镜像默认未内置 flash-attn，绝大多数场景保持 auto 即可
ATTN_IMPL=auto

# ---------------- 鉴权 ----------------
# 留空 = 不鉴权（内网默认）；填写后所有 /api/* 需携带请求头 X-API-Key
API_KEY=

# ---------------- 并发与启动 ----------------
# 模型推理线程数（当前实现为串行，建议保持 1）
MAX_CONCURRENCY=1
# true=启动即加载模型（加载失败容器退出，配合重启策略自动拉起）
PRELOAD_MODEL=true

# ---------------- 音频上传校验 ----------------
MIN_AUDIO_SECONDS=1
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_MB=50

LOG_LEVEL=info
